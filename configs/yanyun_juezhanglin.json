{
  "id": "yanyun_juezhanglin",
  "group": "yanyun",
  "name": "觉樟林",
  "order": 1,
  "description": "先回到主屏幕，再搜索打开燕云并进入游戏。",
  "search": "燕云十六声",
  "keywords": ["燕云十六声", "燕云十六", "燕云"],
  "icon": "icons/yanyun.png",
  "keep_alive": true,
  "reconnect": false,
  "watch_only": true,
  "lost_confirm": 2,
  "steps": [
    {
      "type": "wait_screen",
      "keywords": ["更新公告", "继续游戏", "选择角色", "白露沾衣"],
      "landscape": false,
      "timeout": 20,
      "interval": 1.5,
      "required": false
    },
    {
      "type": "close_popups",
      "name": "关闭公告",
      "timeout": 50,
      "interval": 1.2,
      "required": true,
      "when": ["更新公告", "版本更新", "玩法内容", "白露沾衣", "不删档", "游侠请", "十六巷", "在线修复", "芳草意"],
      "stop_when": ["继续游戏", "选择角色"]
    },
    {
      "type": "ocr_flow",
      "name": "继续游戏",
      "timeout": 25,
      "interval": 1.3,
      "required": false,
      "taps": [
        { "keywords": ["继续游戏"], "wait": 2.2 }
      ],
      "stop_when": ["设置", "进入江湖"]
    }
  ]
}
